<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StaffSync.ViewModels"
             xmlns:utils="clr-namespace:StaffSync.Utils"
             x:Class="StaffSync.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PagePlainLight}, Dark={StaticResource PagePlainDark}}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*, Auto" Padding="24,0,24,40">

        <!-- Üst Blok (Ortalanmış) -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="14">
            <Image WidthRequest="176"
                   HeightRequest="32"
                   Aspect="AspectFit"
                   HorizontalOptions="Start">
                <Image.Source>
                    <AppThemeBinding Light="aunde_logo_positive.svg" Dark="aunde_logo_negative.svg" />
                </Image.Source>
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeServerUrlCommand}" NumberOfTapsRequired="3" />
                </Image.GestureRecognizers>
            </Image>

            <Label Text="AUNDE Rehber"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   Margin="0,28,0,0" />

            <Label Text="Şirket rehberine erişmek için kurumsal hesabınla giriş yap."
                   FontSize="16"
                   LineHeight="1.25"
                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        </VerticalStackLayout>

        <!-- Giriş Formu -->
        <VerticalStackLayout Grid.Row="1" Spacing="14">

            <!-- E-posta -->
            <VerticalStackLayout Spacing="6">
                <Label Text="E-posta"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                <Border HeightRequest="52"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}"
                        Padding="16,0">
                    <Entry Text="{Binding Email}"
                           Placeholder="ad.soyad@sirket.com"
                           Keyboard="Email"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                           ReturnType="Next"
                           VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Şifre -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Şifre"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                <Border HeightRequest="52"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource InputBorderLight}, Dark={StaticResource InputBorderDark}}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource InputBgLight}, Dark={StaticResource InputBgDark}}"
                        Padding="16,0,4,0">
                    <Grid ColumnDefinitions="*, 44">
                        <Entry Grid.Column="0"
                               Text="{Binding Password}"
                               Placeholder="••••••••"
                               IsPassword="{Binding IsPasswordHidden}"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                               ReturnType="Done"
                               ReturnCommand="{Binding LoginCommand}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="0"
                                BackgroundColor="Transparent"
                                FontFamily="Lucide"
                                FontSize="20"
                                Text="{Binding PasswordToggleIcon}"
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Hata Mesajı -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}"
                   FontSize="13"
                   IsVisible="{Binding HasError}"
                   Margin="0,2,0,0" />

            <!-- Giriş Yap Butonu -->
            <Button Text="Giriş yap"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}, FallbackValue=True}"
                    Margin="0,8,0,0" />

            <!-- Yükleniyor Göstergesi -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Brand}"
                               HorizontalOptions="Center" />

            <!-- Şifremi Unuttum Bilgisi -->
            <Label Text="Şifreni mi unuttun? Bilgi Teknolojileri birimine başvur."
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                   HorizontalTextAlignment="Center"
                   Margin="0,4,0,0" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>
