<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StaffSync.ViewModels"
             xmlns:controls="clr-namespace:StaffSync.Controls"
             xmlns:utils="clr-namespace:StaffSync.Utils"
             x:Class="StaffSync.Pages.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageGroupedLight}, Dark={StaticResource PageGroupedDark}}"
             Title="Profil">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Spacing="24" Padding="16,16,16,36">

            <!-- "Profil" Başlığı -->
            <Label Text="Profil"
                   Style="{StaticResource LargeTitle}"
                   Margin="4,0" />

            <!-- Kullanıcı Kartı (Card, 14 Radius) -->
            <Border StrokeShape="RoundRectangle 14"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                    Padding="16">
                <Grid ColumnDefinitions="60, *" ColumnSpacing="14" VerticalOptions="Center">
                    <!-- 60'lık Brand Avatar -->
                    <Border Grid.Column="0"
                            WidthRequest="60"
                            HeightRequest="60"
                            StrokeShape="RoundRectangle 30"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Label Text="{Binding UserInitials}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Kullanıcı Bilgileri -->
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                        <Label Text="{Binding UserDisplayName}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                        <Label Text="{Binding UserEmail}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />

                        <!-- Departman Rozeti -->
                        <Border IsVisible="{Binding HasUserDepartment}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoftLight}, Dark={StaticResource BrandSoftDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 11"
                                HeightRequest="22"
                                Padding="10,0"
                                HorizontalOptions="Start"
                                Margin="0,3,0,0">
                            <Label Text="{Binding UserDepartment}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Yönetici Rozeti (Yalnızca Admin ise) -->
                        <Border IsVisible="{Binding IsAdmin}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoftLight}, Dark={StaticResource BrandSoftDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 11"
                                HeightRequest="22"
                                Padding="10,0"
                                HorizontalOptions="Start"
                                Margin="0,2,0,0">
                            <Label Text="Yönetici"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- SENKRONİZASYON Bölümü -->
            <VerticalStackLayout Spacing="8">
                <Label Text="SENKRONİZASYON"
                       Style="{StaticResource SectionHeader}"
                       Margin="4,0" />

                <Border StrokeShape="RoundRectangle 14"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                        Padding="0">
                    <VerticalStackLayout Spacing="0">

                        <!-- Telefon rehberine aktar -->
                        <Grid ColumnDefinitions="*, Auto" Padding="16,12" ColumnSpacing="12">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="Telefon rehberine aktar"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="Şirket kişileri cihaz rehberinde görünür"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            </VerticalStackLayout>

                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsSyncEnabled}"
                                    Toggled="OnSyncSwitchToggled"
                                    OnColor="{StaticResource Brand}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />

                        <!-- Son senkron -->
                        <Grid ColumnDefinitions="*, Auto" Padding="16,12">
                            <Label Text="Son senkron"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding LastSyncText}"
                                   FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />

                        <!-- Şimdi senkronize et Butonu -->
                        <Grid HeightRequest="48" Padding="16,0" ColumnDefinitions="Auto, *">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SyncNowCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Text="{x:Static utils:LucideIcons.RefreshCw}"
                                   FontFamily="Lucide"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                   VerticalOptions="Center"
                                   Margin="0,0,10,0" />
                            <Label Grid.Column="1"
                                   Text="Şimdi senkronize et"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                   VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Açıklama Metni / Hata Durumu -->
                <Label Text="iPhone'da senkron, uygulama her açıldığında yapılır. Android'de arka planda günde bir kez de çalışır."
                       FontSize="13"
                       LineHeight="1.3"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                       Margin="4,0"
                       IsVisible="{Binding HasSyncError, Converter={StaticResource InvertedBoolConverter}}" />

                <Label Text="{Binding LastSyncError}"
                       FontSize="13"
                       TextColor="{StaticResource Danger}"
                       Margin="4,0"
                       IsVisible="{Binding HasSyncError}" />
            </VerticalStackLayout>

            <!-- GÖRÜNÜM Bölümü -->
            <VerticalStackLayout Spacing="8">
                <Label Text="GÖRÜNÜM"
                       Style="{StaticResource SectionHeader}"
                       Margin="4,0" />

                <Border StrokeShape="RoundRectangle 14"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                        Padding="16,12">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Tema"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                        <controls:SegmentedControl ItemsSource="Sistem,Açık,Koyu"
                                                  SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Sürüm ve Çıkış Kartı -->
            <Border StrokeShape="RoundRectangle 14"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                    Padding="0">
                <VerticalStackLayout Spacing="0">
                    <!-- Sürüm -->
                    <Grid HeightRequest="48" Padding="16,0" ColumnDefinitions="*, Auto">
                        <Label Text="Sürüm"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding AppVersion}"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                               VerticalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />

                    <!-- Çıkış yap -->
                    <Grid HeightRequest="48" Padding="16,0">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="Çıkış yap"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Danger}"
                               VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
