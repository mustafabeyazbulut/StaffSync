<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StaffSync.ViewModels"
             xmlns:controls="clr-namespace:StaffSync.Controls"
             xmlns:utils="clr-namespace:StaffSync.Utils"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="StaffSync.Pages.FilterPage"
             x:DataType="vm:FilterViewModel"
             Shell.PresentationMode="ModalAnimated"
             ios:Page.ModalPresentationStyle="PageSheet"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageGroupedLight}, Dark={StaticResource PageGroupedDark}}"
             Title="Filtrele">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- Tutamak (Grabber Çizgisi) -->
        <BoxView Grid.Row="0"
                 WidthRequest="36"
                 HeightRequest="5"
                 CornerRadius="3"
                 Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                 HorizontalOptions="Center"
                 Margin="0,8,0,0" />

        <!-- Üst Bar: Temizle | Filtrele | Bitti -->
        <Grid Grid.Row="1"
              HeightRequest="44"
              Padding="8,0"
              ColumnDefinitions="Auto, *, Auto">
            <Button Grid.Column="0"
                    Text="Temizle"
                    Command="{Binding ClearFiltersCommand}"
                    FontSize="17"
                    TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                    BackgroundColor="Transparent"
                    Padding="8,0"
                    HeightRequest="44" />

            <Label Grid.Column="1"
                   Text="Filtrele"
                   FontSize="17"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <Button Grid.Column="2"
                    Text="Bitti"
                    Command="{Binding ApplyFiltersCommand}"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                    BackgroundColor="Transparent"
                    Padding="8,0"
                    HeightRequest="44" />
        </Grid>

        <!-- İçerik -->
        <ScrollView Grid.Row="2"
                    Padding="16,8,16,24"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="24">

                <!-- SIRALAMA Bölümü -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="SIRALAMA"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                           Margin="4,0" />

                    <controls:SegmentedControl ItemsSource="Ad,Departman,Unvan"
                                              SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}" />
                </VerticalStackLayout>

                <!-- DEPARTMAN Bölümü -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="DEPARTMAN"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                           Margin="4,0" />

                    <Border StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                            Padding="16,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenDepartmentPickerCommand}" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" MinimumHeightRequest="48">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenDepartmentPickerCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" InputTransparent="True">
                                <Label Text="Departmanlar"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="{Binding SelectedDepartmentsSummary}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <!-- Sayı Rozeti -->
                            <Border Grid.Column="1"
                                    HeightRequest="24"
                                    MinimumWidthRequest="24"
                                    Padding="8,0"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoftLight}, Dark={StaticResource BrandSoftDark}}"
                                    VerticalOptions="Center">
                                <Label Text="{Binding DepartmentCountText}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <!-- Chevron Sağ İkonu -->
                            <Label Grid.Column="2"
                                   Text="{x:Static utils:LucideIcons.ChevronRight}"
                                   FontFamily="Lucide"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- ŞİRKET Bölümü -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="ŞİRKET"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                           Margin="4,0" />

                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                AlignItems="Center"
                                BindableLayout.ItemsSource="{Binding Companies}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CompanyFilterItem">
                                <Border HeightRequest="36"
                                        StrokeShape="RoundRectangle 18"
                                        StrokeThickness="1"
                                        Margin="0,0,8,8"
                                        Padding="14,0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FilterViewModel}}, Path=SelectCompanyCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandSoftLight}, Dark={StaticResource BrandSoftDark}}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Name}"
                                           FontSize="14"
                                           FontAttributes="None"
                                           VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ALT ÇUBUK: Sonuçları Göster -->
        <Border Grid.Row="3"
                StrokeThickness="0"
                Padding="16,12,16,28">
            <VerticalStackLayout Spacing="8">
                <!-- Üst 1px Çizgi -->
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                         Margin="-16,-12,-16,0" />

                <Button Text="{Binding ApplyButtonText}"
                        Command="{Binding ApplyFiltersCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="52"
                        CornerRadius="14"
                        FontSize="17"
                        FontAttributes="Bold" />
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
