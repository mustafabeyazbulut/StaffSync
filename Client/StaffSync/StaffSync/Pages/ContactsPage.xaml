<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StaffSync.ViewModels"
             xmlns:models="clr-namespace:StaffSync.Models"
             xmlns:utils="clr-namespace:StaffSync.Utils"
             xmlns:controls="clr-namespace:StaffSync.Controls"
             x:Class="StaffSync.Pages.ContactsPage"
             x:DataType="vm:ContactsViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PagePlainLight}, Dark={StaticResource PagePlainDark}}"
             Shell.NavBarIsVisible="False"
             Title="Rehber">

    <ContentPage.Resources>
        <!-- Kişi satırı: gruplu ve düz liste aynı şablonu kullanır -->
        <DataTemplate x:Key="ContactRowTemplate" x:DataType="models:ContactDto">
            <Grid RowDefinitions="Auto, 1" Padding="20,10,20,0" controls:Touch.Feedback="True">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ContactsViewModel}}, Path=OpenDetailCommand}"
                                          CommandParameter="{Binding .}" />
                </Grid.GestureRecognizers>

                <Grid Grid.Row="0" ColumnDefinitions="44, *, Auto" ColumnSpacing="12" Margin="0,0,0,10">

                    <!-- Avatar: fotoğraf ya da kişiye özgü marka tonunda baş harfler -->
                    <controls:ContactAvatar Grid.Column="0"
                                            Name="{Binding DisplayName}"
                                            PhotoPath="{Binding PhotoPath}"
                                            Size="44"
                                            VerticalOptions="Center" />

                    <!-- İsim ve Unvan · Departman -->
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding DisplayName}"
                               FontSize="16"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="{Binding Subtitle}"
                               FontSize="13"
                               LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                    </VerticalStackLayout>

                    <!-- Ara: ne arayacağını gösteren hap düğme (şirket hattında kısa kod, değilse "Ara") -->
                    <Border Grid.Column="2"
                            controls:Touch.Feedback="True"
                            controls:Touch.CornerRadius="18"
                            controls:Touch.PressedScale="0.94"
                            HeightRequest="36"
                            MinimumWidthRequest="72"
                            Padding="12,0"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoftLight}, Dark={StaticResource BrandSoftDark}}"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ContactsViewModel}}, Path=CallContactCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{x:Static utils:LucideIcons.Phone}"
                                   FontFamily="Lucide"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding CallLabel}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Avatardan başlayan 1px ayırıcı -->
                <BoxView Grid.Row="1"
                         HeightRequest="1"
                         Margin="56,0,0,0"
                         Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="0">

        <!-- Üst Başlık ve Arama Bloğu (Kompakt: 12 üst padding, 10 spacing) -->
        <VerticalStackLayout Grid.Row="0" Padding="16,12,16,6" Spacing="10">

            <!-- Başlık Satırı -->
            <Grid ColumnDefinitions="*, 44">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Rehber"
                           Style="{StaticResource LargeTitle}" />
                    <Label Text="{Binding LastSyncTimeFormatted}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                </VerticalStackLayout>

                <!-- Sağ Üst Profil Avatarı -->
                <Border Grid.Column="1"
                        controls:Touch.Feedback="True"
                        controls:Touch.CornerRadius="22"
                        controls:Touch.PressedScale="0.92"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource Brand}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{Binding UserInitials}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Arama ve Filtre Satırı -->
            <Grid ColumnDefinitions="*, 44" ColumnSpacing="8">

                <!-- Arama Kutusu -->
                <Border Grid.Column="0"
                        HeightRequest="44"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                        Padding="14,0">
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Grid.Column="0"
                               Text="{x:Static utils:LucideIcons.Search}"
                               FontFamily="Lucide"
                               FontSize="18"
                               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                               VerticalOptions="Center"
                               Margin="0,0,10,0" />
                        <Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="Ad, unvan veya departman ara"
                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               FontSize="16"
                               ClearButtonVisibility="WhileEditing"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Filtre Butonu ve Rozet -->
                <Grid Grid.Column="1" WidthRequest="44" HeightRequest="44"
                      controls:Touch.Feedback="True" controls:Touch.CornerRadius="12" controls:Touch.PressedScale="0.92">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenFilterCommand}" />
                    </Grid.GestureRecognizers>
                    <Border WidthRequest="44"
                            HeightRequest="44"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            InputTransparent="True">
                        <Label Text="{x:Static utils:LucideIcons.SlidersHorizontal}"
                               FontFamily="Lucide"
                               FontSize="20"
                               TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Border>

                    <!-- Aktif Filtre Rozeti -->
                    <Border StrokeThickness="0"
                            BackgroundColor="{StaticResource Brand}"
                            StrokeShape="RoundRectangle 9"
                            MinimumWidthRequest="18"
                            HeightRequest="18"
                            Padding="5,0"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,-4,-4,0"
                            InputTransparent="True"
                            IsVisible="{Binding HasActiveFilters}">
                        <Label Text="{Binding ActiveFilterCount}"
                               TextColor="{StaticResource White}"
                               FontSize="11"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Border>
                </Grid>
            </Grid>

        </VerticalStackLayout>

        <!-- Çevrimdışı Bandı -->
        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoftLight}, Dark={StaticResource BrandSoftDark}}"
                StrokeThickness="0"
                Padding="16,8"
                Margin="20,0,20,8"
                StrokeShape="RoundRectangle 8"
                IsVisible="{Binding IsOffline}">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="{x:Static utils:LucideIcons.Info}"
                       FontFamily="Lucide"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                       VerticalOptions="Center" />
                <Label Text="Çevrimdışı mod — Son kaydedilen veriler gösteriliyor"
                       TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                       FontSize="13"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Liste Başlığı Bilgi Metni (N kişi gösteriliyor · Ada göre sıralı) -->
        <Label Grid.Row="2"
               Text="{Binding ListHeaderLabel}"
               FontSize="13"
               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
               Padding="20,6,20,4" />

        <!-- Kişi Listesi ve Harf Çubuğu -->
        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="{StaticResource Brand}">

            <Grid ColumnDefinitions="*, Auto">

                <!-- A-Z Gruplu Liste -->
                <CollectionView x:Name="GroupedListView"
                                Grid.Column="0"
                                ItemsSource="{Binding GroupedContacts}"
                                IsGrouped="True"
                                ItemTemplate="{StaticResource ContactRowTemplate}"
                                IsVisible="{Binding IsGrouped}"
                                RemainingItemsThreshold="4"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreContactsCommand}"
                                SelectionMode="None">

                    <!-- Grup Başlığı: Temiz, Gri Bant Yok -->
                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate x:DataType="vm:ContactGroup">
                            <Label Text="{Binding Key}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                   Padding="20,14,20,6" />
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>

                    <!-- Boş Durum -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="8" Padding="32,64" VerticalOptions="Center" HorizontalOptions="Center"
                                             IsVisible="{Binding IsEmpty}">
                            <Label Text="Sonuç bulunamadı"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="Farklı bir ad veya departman deneyin."
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <!-- Alt Yükleniyor Satırı -->
                    <CollectionView.Footer>
                        <Grid HeightRequest="60" IsVisible="{Binding IsLoadingMore}">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{x:Static utils:LucideIcons.Loader}"
                                       FontFamily="Lucide"
                                       FontSize="18"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                       VerticalOptions="Center" />
                                <Label Text="Daha fazla kişi yükleniyor"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </CollectionView.Footer>
                </CollectionView>

                <!-- Düz Liste (Grupsuz - Departman veya Unvan sıralamasında) -->
                <CollectionView Grid.Column="0"
                                ItemsSource="{Binding Contacts}"
                                ItemTemplate="{StaticResource ContactRowTemplate}"
                                IsVisible="{Binding IsNotGrouped}"
                                RemainingItemsThreshold="4"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreContactsCommand}"
                                SelectionMode="None">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="8" Padding="32,64" VerticalOptions="Center" HorizontalOptions="Center"
                                             IsVisible="{Binding IsEmpty}">
                            <Label Text="Sonuç bulunamadı"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="Farklı bir ad veya departman deneyin."
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.Footer>
                        <Grid HeightRequest="60" IsVisible="{Binding IsLoadingMore}">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{x:Static utils:LucideIcons.Loader}"
                                       FontFamily="Lucide"
                                       FontSize="18"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                       VerticalOptions="Center" />
                                <Label Text="Daha fazla kişi yükleniyor"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </CollectionView.Footer>
                </CollectionView>

                <!-- İlk yükleme iskeleti: liste boşken "Sonuç bulunamadı" yanıp sönmesin -->
                <VerticalStackLayout x:Name="SkeletonList"
                                     Grid.Column="0"
                                     IsVisible="{Binding ShowSkeleton}"
                                     InputTransparent="True"
                                     Spacing="1"
                                     Padding="0,8,0,0">
                    <Grid ColumnDefinitions="44, *" ColumnSpacing="12" Padding="20,10" HeightRequest="65">
                        <Ellipse Grid.Column="0" WidthRequest="44" HeightRequest="44" Fill="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <BoxView HeightRequest="12" WidthRequest="170" HorizontalOptions="Start" CornerRadius="6" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                            <BoxView HeightRequest="10" WidthRequest="120" HorizontalOptions="Start" CornerRadius="5" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="44, *" ColumnSpacing="12" Padding="20,10" HeightRequest="65">
                        <Ellipse Grid.Column="0" WidthRequest="44" HeightRequest="44" Fill="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <BoxView HeightRequest="12" WidthRequest="140" HorizontalOptions="Start" CornerRadius="6" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                            <BoxView HeightRequest="10" WidthRequest="190" HorizontalOptions="Start" CornerRadius="5" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="44, *" ColumnSpacing="12" Padding="20,10" HeightRequest="65">
                        <Ellipse Grid.Column="0" WidthRequest="44" HeightRequest="44" Fill="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <BoxView HeightRequest="12" WidthRequest="200" HorizontalOptions="Start" CornerRadius="6" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                            <BoxView HeightRequest="10" WidthRequest="110" HorizontalOptions="Start" CornerRadius="5" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="44, *" ColumnSpacing="12" Padding="20,10" HeightRequest="65">
                        <Ellipse Grid.Column="0" WidthRequest="44" HeightRequest="44" Fill="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <BoxView HeightRequest="12" WidthRequest="150" HorizontalOptions="Start" CornerRadius="6" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                            <BoxView HeightRequest="10" WidthRequest="160" HorizontalOptions="Start" CornerRadius="5" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="44, *" ColumnSpacing="12" Padding="20,10" HeightRequest="65">
                        <Ellipse Grid.Column="0" WidthRequest="44" HeightRequest="44" Fill="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <BoxView HeightRequest="12" WidthRequest="180" HorizontalOptions="Start" CornerRadius="6" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                            <BoxView HeightRequest="10" WidthRequest="130" HorizontalOptions="Start" CornerRadius="5" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="44, *" ColumnSpacing="12" Padding="20,10" HeightRequest="65">
                        <Ellipse Grid.Column="0" WidthRequest="44" HeightRequest="44" Fill="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <BoxView HeightRequest="12" WidthRequest="130" HorizontalOptions="Start" CornerRadius="6" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                            <BoxView HeightRequest="10" WidthRequest="170" HorizontalOptions="Start" CornerRadius="5" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="44, *" ColumnSpacing="12" Padding="20,10" HeightRequest="65">
                        <Ellipse Grid.Column="0" WidthRequest="44" HeightRequest="44" Fill="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <BoxView HeightRequest="12" WidthRequest="190" HorizontalOptions="Start" CornerRadius="6" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                            <BoxView HeightRequest="10" WidthRequest="140" HorizontalOptions="Start" CornerRadius="5" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="44, *" ColumnSpacing="12" Padding="20,10" HeightRequest="65">
                        <Ellipse Grid.Column="0" WidthRequest="44" HeightRequest="44" Fill="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <BoxView HeightRequest="12" WidthRequest="160" HorizontalOptions="Start" CornerRadius="6" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                            <BoxView HeightRequest="10" WidthRequest="120" HorizontalOptions="Start" CornerRadius="5" BackgroundColor="Transparent" Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- Sağ A-Z Harf Çubuğu (Sade Stil: 11px BrandText, zemin yok, ince sütun) -->
                <ScrollView Grid.Column="1"
                            IsVisible="{Binding IsGrouped}"
                            VerticalScrollBarVisibility="Never"
                            WidthRequest="28"
                            Margin="0,0,2,0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding AlphabetLetters}"
                                         Spacing="0"
                                         VerticalOptions="Center">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid WidthRequest="28" HeightRequest="22">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLetterTapped" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding .}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

            </Grid>
        </RefreshView>

        <!-- Harf çubuğuna basınca ortada beliren harf balonu -->
        <Border x:Name="LetterBubble"
                Grid.Row="3"
                WidthRequest="72"
                HeightRequest="72"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0"
                BackgroundColor="{StaticResource Brand}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="0,0,0,80"
                Opacity="0"
                Scale="0.8"
                InputTransparent="True">
            <Label x:Name="LetterBubbleLabel"
                   FontSize="34"
                   FontAttributes="Bold"
                   TextColor="{StaticResource White}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>

    </Grid>

</ContentPage>
