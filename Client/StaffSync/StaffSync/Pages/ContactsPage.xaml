<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StaffSync.ViewModels"
             xmlns:models="clr-namespace:StaffSync.Models"
             x:Class="StaffSync.Pages.ContactsPage"
             x:DataType="vm:ContactsViewModel"
             Title="AUNDE Rehber">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="0">

        <!-- Üst Arama ve Filtre Çubuğu -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,12" ColumnSpacing="10">
            <Border Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkCard}}"
                    Padding="12,0"
                    HeightRequest="46">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Text="🔍" FontSize="14" VerticalOptions="Center" Margin="0,0,8,0" />
                    <Entry Grid.Column="1"
                           Text="{Binding SearchText}"
                           Placeholder="İsim, unvan veya departman..."
                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                           FontSize="14"
                           ClearButtonVisibility="WhileEditing"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Filtreleme Butonu ve Rozet -->
            <Grid Grid.Column="1" WidthRequest="46" HeightRequest="46">
                <Button Command="{Binding OpenFilterCommand}"
                        Text="⚙️"
                        FontSize="18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource DarkCard}}"
                        CornerRadius="10"
                        Padding="0"
                        HeightRequest="46"
                        WidthRequest="46" />
                <!-- Aktif Filtre Sayısı Rozeti -->
                <Border Stroke="Transparent"
                        BackgroundColor="{StaticResource Danger}"
                        StrokeShape="RoundRectangle 8"
                        WidthRequest="18"
                        HeightRequest="18"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,-2,-2,0"
                        IsVisible="{Binding HasActiveFilters}">
                    <Label Text="{Binding ActiveFilterCount}"
                           TextColor="White"
                           FontSize="10"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>
        </Grid>

        <!-- Aktif Filtre Çipleri -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    Padding="16,0,16,8" IsVisible="{Binding HasActiveFilters}">
            <HorizontalStackLayout Spacing="8">
                <!-- Şirket Çipi -->
                <Border Stroke="{StaticResource Primary}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkCard}}"
                        StrokeShape="RoundRectangle 16"
                        Padding="10,4"
                        IsVisible="{Binding HasSelectedCompany}">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding SelectedCompany}" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                               VerticalOptions="Center" />
                        <Button Text="✕" Command="{Binding ClearCompanyFilterCommand}"
                                BackgroundColor="Transparent" Padding="0"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                FontSize="10" WidthRequest="18" HeightRequest="18" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Departman Çipleri -->
                <BindableLayout.ItemsSource>
                    <Binding Path="ActiveDepartmentFilters" />
                </BindableLayout.ItemsSource>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Stroke="{StaticResource Primary}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkCard}}"
                                StrokeShape="RoundRectangle 16"
                                Padding="10,4">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding .}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                       VerticalOptions="Center" />
                                <Button Text="✕"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ContactsViewModel}}, Path=RemoveDepartmentFilterCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent" Padding="0"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        FontSize="10" WidthRequest="18" HeightRequest="18" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>

                <!-- Tümünü Temizle Butonu -->
                <Button Text="Tümünü Temizle"
                        Command="{Binding ClearAllFiltersCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Danger}"
                        FontSize="11"
                        Padding="4,0"
                        HeightRequest="32" />
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Çevrimdışı Mod Uyarı Bandı -->
        <Border Grid.Row="2"
                BackgroundColor="#FEF3C7"
                Stroke="#F59E0B"
                StrokeThickness="1"
                Padding="12,6"
                Margin="16,0,16,8"
                StrokeShape="RoundRectangle 8"
                IsVisible="{Binding IsOffline}">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                <Label Text="Çevrimdışı mod — Son kaydedilen veriler gösteriliyor"
                       TextColor="#92400E"
                       FontSize="12"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Kişi Listesi -->
        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="{StaticResource Primary}">

            <CollectionView ItemsSource="{Binding Contacts}"
                            RemainingItemsThreshold="4"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreContactsCommand}"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ContactDto">
                        <Border Stroke="Transparent"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkCard}}"
                                Margin="16,4"
                                Padding="12"
                                StrokeShape="RoundRectangle 12">
                            <Border.Shadow>
                                <Shadow Brush="#000000" Opacity="0.04" Offset="0,2" Radius="4" />
                            </Border.Shadow>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ContactsViewModel}}, Path=OpenDetailCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <!-- Avatar / İsim Baş Harfleri -->
                                <Border Grid.Column="0"
                                        WidthRequest="46"
                                        HeightRequest="46"
                                        StrokeShape="RoundRectangle 23"
                                        Stroke="Transparent"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource AundeDeepBlue}}"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Initials}"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Bilgiler -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label Text="{Binding DisplayName}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                                    <Label Text="{Binding Subtitle}"
                                           FontSize="12"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

                                    <!-- Dahili / Kısa Kod -->
                                    <Label Text="{Binding Home, StringFormat='Dahili: {0}'}"
                                           FontSize="11"
                                           TextColor="{StaticResource Primary}"
                                           IsVisible="{Binding HasShortCode}" />
                                </VerticalStackLayout>

                                <!-- Hızlı Arama Butonu -->
                                <Button Grid.Column="2"
                                        Text="📞"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ContactsViewModel}}, Path=CallContactCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding HasPhone}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                        CornerRadius="22"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        Padding="0"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Boş Liste -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="12" Padding="40" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="👥" FontSize="44" HorizontalOptions="Center" />
                        <Label Text="Kayıt Bulunamadı"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource White}}" />
                        <Label Text="Arama terimlerinizi veya seçtiğiniz filtreleri değiştirmeyi deneyebilirsiniz."
                               FontSize="13"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!-- Liste Sonu Yükleniyor Göstergesi -->
                <CollectionView.Footer>
                    <Grid HeightRequest="60" IsVisible="{Binding IsLoadingMore}">
                        <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                           Color="{StaticResource Primary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                    </Grid>
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
