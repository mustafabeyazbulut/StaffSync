<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StaffSync.ViewModels"
             xmlns:utils="clr-namespace:StaffSync.Utils"
             x:Class="StaffSync.Pages.ContactDetailPage"
             x:DataType="vm:ContactDetailViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageGroupedLight}, Dark={StaticResource PageGroupedDark}}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Kişi Detayı">

    <Grid RowDefinitions="Auto, *" Padding="0">

        <!-- Üst Bar: ‹ Rehber -->
        <Grid Grid.Row="0" HeightRequest="44" Padding="8,4,8,4">
            <HorizontalStackLayout Spacing="2"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Start">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Label Text="{x:Static utils:LucideIcons.ChevronLeft}"
                       FontFamily="Lucide"
                       FontSize="22"
                       TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                       VerticalOptions="Center" />
                <Label Text="Rehber"
                       FontSize="17"
                       TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <!-- İçerik -->
        <ScrollView Grid.Row="1"
                    Padding="16,8,16,32"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="20">

                <!-- Kimlik Bloğu (Ortalı) -->
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,4,0,0">
                    <!-- 96'lık daire avatar -->
                    <Border WidthRequest="96"
                            HeightRequest="96"
                            StrokeShape="RoundRectangle 48"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource Brand}"
                            HorizontalOptions="Center">
                        <Label Text="{Binding Contact.Initials}"
                               TextColor="{StaticResource White}"
                               FontSize="34"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Ad ve Unvan -->
                    <Label Text="{Binding Contact.DisplayName}"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,10,0,0" />

                    <Label Text="{Binding Contact.JobTitle}"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <!-- Departman Hapı -->
                    <Border HeightRequest="26"
                            Padding="12,0"
                            StrokeShape="RoundRectangle 13"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandSoftLight}, Dark={StaticResource BrandSoftDark}}"
                            HorizontalOptions="Center"
                            Margin="0,4,0,0"
                            IsVisible="{Binding HasDepartment}">
                        <Label Text="{Binding Contact.Department}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>

                <!-- Hızlı Aksiyonlar: 4 Eşit Sütun (Grid.Column zorunlu) -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">

                    <!-- Ara -->
                    <Border Grid.Column="0"
                            HeightRequest="68"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CallPhoneCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{x:Static utils:LucideIcons.Phone}"
                                   FontFamily="Lucide"
                                   FontSize="22"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                   HorizontalOptions="Center" />
                            <Label Text="Ara"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Mesaj -->
                    <Border Grid.Column="1"
                            HeightRequest="68"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendSmsCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{x:Static utils:LucideIcons.MessageSquare}"
                                   FontFamily="Lucide"
                                   FontSize="22"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                   HorizontalOptions="Center" />
                            <Label Text="Mesaj"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- E-posta -->
                    <Border Grid.Column="2"
                            HeightRequest="68"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SendEmailCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{x:Static utils:LucideIcons.Mail}"
                                   FontFamily="Lucide"
                                   FontSize="22"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                   HorizontalOptions="Center" />
                            <Label Text="E-posta"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- WhatsApp -->
                    <Border Grid.Column="3"
                            HeightRequest="68"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenWhatsAppCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{x:Static utils:LucideIcons.MessageCircle}"
                                   FontFamily="Lucide"
                                   FontSize="22"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                   HorizontalOptions="Center" />
                            <Label Text="WhatsApp"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Bilgi Kartı (Tek Card, 14 Radius) -->
                <Border StrokeShape="RoundRectangle 14"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                        Padding="0">
                    <VerticalStackLayout Spacing="0">

                        <!-- Cep telefonu -->
                        <VerticalStackLayout Spacing="2"
                                             Padding="16,12"
                                             IsVisible="{Binding Contact.HasPhone}">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CallPhoneCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="Cep telefonu"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            <Label Text="{Binding Contact.TelephoneNumber}"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}" />
                        </VerticalStackLayout>

                        <!-- Ayırıcı -->
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                                 IsVisible="{Binding Contact.HasPhone}" />

                        <!-- Dahili / kısa kod -->
                        <VerticalStackLayout Spacing="2"
                                             Padding="16,12"
                                             IsVisible="{Binding Contact.HasShortCode}">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CallShortCodeCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="Dahili / kısa kod"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            <Label Text="{Binding Contact.Home}"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}" />
                        </VerticalStackLayout>

                        <!-- Ayırıcı -->
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                                 IsVisible="{Binding Contact.HasShortCode}" />

                        <!-- E-posta -->
                        <VerticalStackLayout Spacing="2"
                                             Padding="16,12"
                                             IsVisible="{Binding Contact.HasEmail}">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SendEmailCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="E-posta"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            <Label Text="{Binding Contact.Email}"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}" />
                        </VerticalStackLayout>

                        <!-- Ayırıcı -->
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                                 IsVisible="{Binding Contact.HasEmail}" />

                        <!-- Ofis -->
                        <VerticalStackLayout Spacing="2"
                                             Padding="16,12"
                                             IsVisible="{Binding HasOffice}">
                            <Label Text="Ofis"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            <Label Text="{Binding Contact.Office}"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </VerticalStackLayout>

                        <!-- Ayırıcı -->
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                                 IsVisible="{Binding HasOffice}" />

                        <!-- Şirket -->
                        <VerticalStackLayout Spacing="2"
                                             Padding="16,12"
                                             IsVisible="{Binding HasCompany}">
                            <Label Text="Şirket"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            <Label Text="{Binding Contact.Company}"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </VerticalStackLayout>

                        <!-- Ayırıcı -->
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}"
                                 IsVisible="{Binding HasCompany}" />

                        <!-- Yönetici -->
                        <VerticalStackLayout Spacing="2"
                                             Padding="16,12"
                                             IsVisible="{Binding HasManager}">
                            <Label Text="Yönetici"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            <Label Text="{Binding Contact.ManagerName}"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Telefon rehberime kaydet Butonu -->
                <Border HeightRequest="52"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SaveToContactsCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                        <Label Text="{x:Static utils:LucideIcons.UserPlus}"
                               FontFamily="Lucide"
                               FontSize="20"
                               TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                               VerticalOptions="Center" />
                        <Label Text="Telefon rehberime kaydet"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource BrandTextLight}, Dark={StaticResource BrandTextDark}}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Hatalı bilgi bildir -->
                <HorizontalStackLayout Spacing="8"
                                       HeightRequest="44"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ReportCorrectionCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="{x:Static utils:LucideIcons.Info}"
                           FontFamily="Lucide"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                           VerticalOptions="Center" />
                    <Label Text="Hatalı bilgi bildir"
                           FontSize="15"
                           FontFamily="OpenSansSemibold"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
