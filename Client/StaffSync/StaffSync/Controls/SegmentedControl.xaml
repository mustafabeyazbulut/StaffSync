<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StaffSync.Controls.SegmentedControl"
             x:Name="ThisControl">
    <Border StrokeShape="RoundRectangle 10"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource SegTrackLight}, Dark={StaticResource SegTrackDark}}"
            Padding="2">
        <Grid x:Name="SegmentsGrid"
              ColumnSpacing="2"
              VerticalOptions="Center" />
    </Border>
</ContentView>
